# Tarang Expense Intelligence - Environment Configuration Example

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=False

# Policy Thresholds
AUTO_APPROVE_THRESHOLD=2000.00
AMOUNT_TOLERANCE=10.00
FOOD_LIMIT_WITHOUT_APPROVAL=2500.00

# OCR Engine Configuration
# Windows native OCR runs out of the box via Windows.Media.Ocr.
# For Linux/Docker, set path to tesseract binary if not in system PATH:
# TESSERACT_CMD=/usr/bin/tesseract

# Optional External AI Vision Model (Not required - system runs 100% locally by default)
# VISION_PROVIDER=none
# VISION_API_KEY=
